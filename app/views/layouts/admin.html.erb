<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>Admin – <%= @s['name1'] %><%= @s['name2'] %></title>
<%= csrf_meta_tags %>
<style>
:root{--accent:<%= @s['l_accent'] %>;--accent-ink:<%= @s['l_accent_ink'] %>}
*{box-sizing:border-box}
body{margin:0;font:15px/1.5 -apple-system,'Segoe UI',Inter,system-ui,sans-serif;background:#f4f5f8;color:#111827}
a{color:inherit}

.ah{background:#0d1421;color:#fff;padding:.9rem 1.3rem;display:flex;align-items:center;gap:.6rem}
.ah b{font-size:15px;letter-spacing:-.01em}
.ah .site{color:#9ca3af;font-size:13px}
.ah .dot{width:8px;height:8px;border-radius:50%;background:var(--accent)}

.atabs{position:sticky;top:0;z-index:10;display:flex;align-items:center;gap:2px;padding:.55rem .9rem;background:#fff;border-bottom:1px solid #e5e7eb;overflow-x:auto;white-space:nowrap}
.atabs a{padding:.4rem .8rem;border-radius:999px;color:#4b5563;text-decoration:none;font-weight:600;font-size:13.5px}
.atabs a:hover{background:#f3f4f6}
.atabs a.on{background:var(--accent);color:var(--accent-ink)}
.atabs .sp{margin-left:auto;display:flex;align-items:center;gap:.4rem;flex-shrink:0}
.atabs form.button_to{display:inline-flex;margin:0}

main{max-width:820px;margin:0 auto;padding:1.6rem 1rem 4rem}
.card{background:#fff;border:1px solid #e5e7eb;border-radius:14px;padding:1.4rem;margin-bottom:1.1rem;box-shadow:0 1px 2px rgba(16,24,40,.04)}
.card h2{margin:0 0 .3rem;font-size:1.25rem;letter-spacing:-.01em}
.card .sub{color:#6b7280;font-size:13.5px;margin:0 0 1rem}
h3{margin:1.5rem 0 .5rem;font-size:12px;text-transform:uppercase;letter-spacing:.06em;color:#6b7280;font-weight:700}
h3:first-of-type{margin-top:0}

label{display:block;font-weight:600;font-size:13px;margin:.8rem 0 .3rem;color:#374151}
input,select,textarea{width:100%;padding:.55rem .7rem;border:1px solid #d7dae0;border-radius:8px;font:inherit;background:#fff;color:#111827}
input:focus,select:focus,textarea:focus{outline:none;border-color:var(--accent);box-shadow:0 0 0 3px color-mix(in srgb,var(--accent) 20%,transparent)}
input[type=color]{height:40px;padding:3px;cursor:pointer}
input[type=file]{padding:.4rem}

.btn,input[type=submit],button.b{display:inline-flex;align-items:center;justify-content:center;gap:.35rem;background:var(--accent);color:var(--accent-ink);border:0;border-radius:8px;padding:.55rem 1rem;font:600 13.5px inherit;cursor:pointer;text-decoration:none}
.btn.alt,button.alt{background:#fff;color:#111827;border:1px solid #d7dae0}
.btn.red,button.red{background:#fff;color:#b91c1c;border:1px solid #f3b4b4}
.btn.sm,button.sm{padding:.4rem .7rem;font-size:12.5px}
.btn.block{display:flex;width:100%;text-align:center}
form.button_to{display:inline-flex;margin:0}

.item{display:flex;align-items:center;gap:1rem;justify-content:space-between;padding:.85rem 1rem;border:1px solid #e9eaee;border-radius:10px;margin-bottom:.55rem;background:#fff}
.item:hover{border-color:#d7dae0}
.item-main{min-width:0}
.item-main b{display:block;font-size:14.5px;font-weight:700}
.item-main .muted{display:block;color:#8a93a3;font-size:12.5px;margin-top:2px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:60vw}
.item-actions{display:flex;align-items:center;gap:.35rem;flex-shrink:0}
.icon{width:1.85rem;height:1.85rem;padding:0;display:inline-flex;align-items:center;justify-content:center;border:1px solid #d7dae0;border-radius:7px;background:#fff;color:#4b5563;font:inherit;cursor:pointer}
.icon:hover{background:#f3f4f6}
.count{display:inline-block;background:#eef0f4;color:#6b7280;border-radius:999px;padding:.1rem .55rem;font-size:12px;font-weight:700;margin-left:.4rem}

.foot{display:flex;gap:.5rem;flex-wrap:wrap;padding-top:1rem;margin-top:.4rem;border-top:1px solid #eee}
.note{font-size:12.5px;color:#8a93a3;margin-top:.6rem;line-height:1.5}
.notice{background:#e7f8ee;color:#0a7a45;padding:.65rem 1rem;border-radius:10px;margin-bottom:1rem;font-weight:600;font-size:13.5px}
.alert{background:#fdecec;color:#b91c1c;padding:.65rem 1rem;border-radius:10px;margin-bottom:1rem;font-weight:600;font-size:13.5px}
.err{color:#b91c1c;font-size:13px;margin:.2rem 0}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:0 1rem}
@media(max-width:560px){.grid2{grid-template-columns:1fr}.item-main .muted{max-width:44vw}}
</style>
</head>
<body>
<div class="ah"><span class="dot"></span><b>Site admin</b><span class="site">· <%= @s['name1'] %><%= @s['name2'] %></span></div>
<nav class="atabs">
  <% if session[:admin] %>
    <%= link_to 'Settings', admin_root_path, class: (controller_name == 'settings' && action_name != 'export' ? 'on' : nil) %>
    <% ContentItem::KINDS.each do |k, m| %>
      <%= link_to m[:label], admin_items_path(kind: k), class: (params[:kind] == k ? 'on' : nil) %>
    <% end %>
    <span class="sp">
      <%= link_to 'Export JSON', export_admin_settings_path, class: 'btn alt sm' %>
      <%= form_with url: import_admin_settings_path, method: :post, multipart: true do %>
        <label class="btn alt sm" for="navimport" style="margin:0">Import JSON</label>
        <input type="file" id="navimport" name="file" accept="application/json" hidden onchange="this.form.requestSubmit()">
      <% end %>
      <%= link_to 'View site ↗', root_path, target: '_blank', class: 'btn alt sm' %>
      <%= button_to 'Log out', logout_path, method: :delete, class: 'btn red sm' %>
    </span>
  <% end %>
</nav>
<main>
  <% if notice %><div class="notice"><%= notice %></div><% end %>
  <% if alert %><div class="alert"><%= alert %></div><% end %>
  <%= yield %>
</main>
</body>
</html>
