<% m = ContentItem::KINDS[@item.kind] %>
<div class="card">
  <h2><%= @item.persisted? ? 'Edit' : 'Add' %> – <%= m[:label] %></h2>
  <%= form_with model: @item, url: (@item.persisted? ? admin_item_path(@item) : admin_items_path) do |f| %>
    <% @item.errors.full_messages.each do |e| %><p class="err"><%= e %></p><% end %>
    <%= f.hidden_field :kind %>
    <%= f.label :title, m[:t] %><%= f.text_field :title, autofocus: true %>
    <% if m[:b] %><%= f.label :body, m[:b] %><%= f.text_area :body, rows: 4 %><% end %>
    <p><%= f.submit 'Save' %> <%= link_to 'Cancel', admin_items_path(kind: @item.kind), class: 'btn alt' %></p>
  <% end %>
</div>
