<div class="success-container">
  <div class="success-card">
    <div class="success-icon">
      <svg viewBox="0 0 80 80" xmlns="http://www.w3.org/2000/svg">
        <circle cx="40" cy="40" r="38" fill="url(#success-gradient)" />
        <path class="checkmark" d="M24 41 L35 52 L57 29" fill="none" stroke="var(--accent-ink)" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" />
        <defs>
          <linearGradient id="success-gradient" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0%" stop-color="var(--accent)" />
            <stop offset="100%" stop-color="var(--pop)" />
          </linearGradient>
        </defs>
      </svg>
    </div>

    <h1>You're All Set!</h1>
    <p class="lede">Your Ultimate Creator Bundle is ready.</p>

    <% if @purchase %>
      <div class="download-block">
        <a href="<%= download_path(token: @purchase.token) %>" class="download-button">
          Download Your Templates
        </a>
      </div>

      <p class="email-note">
        A copy of your download link has also been sent to:<br>
        <strong><%= @purchase.email %></strong>
      </p>
    <% else %>
      <div class="processing-note">
        <p>Your purchase is being processed. You'll receive an email with your download link shortly.</p>
      </div>
    <% end %>

    <div class="support-footer">
      <p>Need help? Contact us at <a href="mailto:support@templatebar.com">support@templatebar.com</a></p>
    </div>
  </div>
</div>

<style>
  .success-container {
    max-width: 600px;
    margin: 60px auto;
    padding: 0 20px;
  }

  .success-card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius, 16px);
    padding: 48px 36px;
    text-align: center;
  }

  .success-icon {
    width: 72px;
    height: 72px;
    margin: 0 auto 24px;
  }

  .success-icon svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .success-icon .checkmark {
    stroke-dasharray: 40;
    stroke-dashoffset: 40;
    animation: draw-check 0.5s ease 0.15s forwards;
  }

  @keyframes draw-check {
    to { stroke-dashoffset: 0; }
  }

  .success-card h1 {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 32px;
    font-weight: 700;
    color: var(--ink);
    margin: 0 0 10px;
  }

  .success-card .lede {
    font-family: 'Inter', sans-serif;
    font-size: 18px;
    color: var(--muted);
    margin: 0 0 30px;
  }

  .download-block {
    margin: 30px 0;
  }

  .download-button {
    display: inline-block;
    background: linear-gradient(135deg, var(--accent) 0%, var(--pop) 100%);
    color: var(--accent-ink);
    text-decoration: none;
    padding: 15px 40px;
    border-radius: calc(var(--radius, 16px) * 0.4);
    font-family: 'Inter', sans-serif;
    font-weight: 600;
    font-size: 18px;
    transition: opacity 0.15s ease, transform 0.15s ease;
  }

  .download-button:hover {
    opacity: 0.92;
    transform: translateY(-1px);
  }

  .email-note {
    font-family: 'Inter', sans-serif;
    color: var(--muted);
    font-size: 15px;
    margin-top: 28px;
    line-height: 1.6;
  }

  .email-note strong {
    color: var(--ink);
  }

  .processing-note {
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: calc(var(--radius, 16px) * 0.5);
    padding: 20px;
    margin: 24px 0;
  }

  .processing-note p {
    font-family: 'Inter', sans-serif;
    color: var(--muted);
    font-size: 15px;
    margin: 0;
    line-height: 1.5;
  }

  .support-footer {
    margin-top: 36px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }

  .support-footer p {
    font-family: 'Inter', sans-serif;
    color: var(--muted);
    font-size: 14px;
    margin: 0;
  }

  .support-footer a {
    color: var(--accent);
    text-decoration: none;
  }

  .support-footer a:hover {
    text-decoration: underline;
  }
</style>
